__pycache__/
*.pyc

# 자료 폴더의 PDF·이미지 — 공개 리포에 책 스캔이 올라가지 않도록 차단 (.md/.txt는 허용)
자료/*.pdf
자료/*.png
자료/*.jpg
자료/*.jpeg
자료/*.webp
자료/*/

# i18n 원본 폰트 (재다운로드 가능한 대용량 바이너리)
i18n/fonts_src/*.ttf
i18n_batch.log

# 작업용 임시 폴더 — 원본 백업 HTML·스크립트가 들어 있어 공개 리포에 올리지 않는다
.tmp/
_archive/cover-backup-*/
*.bak-*

# Claude 작업 폴더 — 추적하지 않는다. 이게 남아 원격과 이름이 겹치면
# git pull --rebase 가 abort 하고 생산이 조용히 멈춘다 (2026-07-27 7일 장애)
output/

# Claude 조사·작업 임시 폴더 — 추적하지 않는다.
#   여기에 조사 결과를 남겨 두면 실패 재시도가 처음부터 다시 조사하지 않는다(토큰 23% 절감).
#   output/ 과 같은 이유로 반드시 무시해야 한다 — 원격과 이름이 겹치면
#   git pull --rebase 가 abort 하고 생산이 조용히 멈춘다.
.build-scratch/
